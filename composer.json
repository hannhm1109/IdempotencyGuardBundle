{
    "name": "hanane/idempotency-guard-bundle",
    "description": "Idempotency keys and safe response replay for selected Symfony HTTP operations.",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.1",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache": "^6.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/security-core": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/framework-bundle": "^6.4",
        "symfony/security-http": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Hanane\\IdempotencyGuardBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanane\\IdempotencyGuardBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
