{
    "name": "hanane/idempotency-guard-bundle",
    "description": "Idempotency keys and safe response replay for selected Symfony HTTP operations.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "idempotency", "http", "retries", "concurrency"],
    "homepage": "https://github.com/hannhm1109/IdempotencyGuardBundle",
    "authors": [
        {
            "name": "Hanane",
            "homepage": "https://github.com/hannhm1109"
        }
    ],
    "support": {
        "issues": "https://github.com/hannhm1109/IdempotencyGuardBundle/issues",
        "source": "https://github.com/hannhm1109/IdempotencyGuardBundle",
        "docs": "https://github.com/hannhm1109/IdempotencyGuardBundle/blob/main/docs/index.md"
    },
    "require": {
        "php": ">=8.1",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/cache": "^6.4",
        "symfony/clock": "^6.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/security-core": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/framework-bundle": "^6.4",
        "symfony/process": "^6.4",
        "symfony/security-http": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Hanane\\IdempotencyGuardBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanane\\IdempotencyGuardBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "example": "@php examples/quickstart.php",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test",
            "@example"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/.github", "/.gitattributes", "/.gitignore", "/.phpunit.cache", "/composer.lock",
            "/phpunit.xml.dist", "/phpstan.neon.dist", "/tests", "/tools", "/var", "/vendor"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
